<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Defaults to the OS doing the build; pass -r win-x64 or -r linux-x64 to target a specific platform. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove=".github\**" />
    <EmbeddedResource Remove=".github\**" />
    <None Remove=".github\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.56.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- The script engine and database providers live in the Dnp.ScriptRunner.Core library. -->
    <ProjectReference Include="..\ScriptRunner.Core\Dnp.ScriptRunner.Core.csproj" />
  </ItemGroup>
  <!-- IBM ships a separate DB2 driver package per OS; both expose the IBM.Data.Db2 namespace. The Core library only
       compiles against it, so the app supplies the runtime driver for its platform. -->
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('linux'))">
    <PackageReference Include="Net.IBM.Data.Db2-lnx" Version="10.0.0.200" />
  </ItemGroup>
  <ItemGroup Condition="!$(RuntimeIdentifier.StartsWith('linux'))">
    <PackageReference Include="Net.IBM.Data.Db2" Version="10.0.0.200" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="images\" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
